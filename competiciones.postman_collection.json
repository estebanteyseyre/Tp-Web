{
  "info": {
    "name": "TP Tecnologías Web - Competiciones",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Listar Competiciones",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/competiciones"
        }
      }
    },
    {
      "name": "Filtrar Competiciones por Nombre",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/competiciones?nombre=",
          "query": [
            {
              "key": "nombre",
              "value": ""
            }
          ]
        }
      }
    },
    {
      "name": "Obtener Competición por ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/competiciones/1"
        }
      }
    },
    {
      "name": "Crear Competición",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"\",\n  \"premio\": \"\",\n  \"fecha\": \"\",\n  \"lugar\": \"\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/competiciones"
        }
      }
    },
    {
      "name": "Editar Competición",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"premio\": \"\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/competiciones/1"
        }
      }
    },
    {
      "name": "Eliminar Competición",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/competiciones/1"
        }
      }
    },
    {
      "name": "Error: id no numérico (400)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/competiciones/abc"
        }
      }
    },
    {
      "name": "Error: competición inexistente (404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/competiciones/999"
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ]
}
