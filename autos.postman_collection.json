{
  "info": {
    "name": "TP Tecnologías Web - Autos",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Listar Autos",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/autos"
        }
      }
    },
    {
      "name": "Filtrar Autos por Piloto",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/autos?piloto=",
          "query": [
            {
              "key": "piloto",
              "value": ""
            }
          ]
        }
      }
    },
    {
      "name": "Obtener Auto por ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/autos/1"
        }
      }
    },
    {
      "name": "Crear Auto",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"modelo\": \"\",\n  \"marca\": \"\",\n  \"numero\": 0,\n  \"potencia\": 0,\n  \"piloto\": \"\",\n  \"categoria\": \"\",\n  \"competicionId\": 1\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/autos"
        }
      }
    },
    {
      "name": "Editar Auto",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"potencia\": 0\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/autos/1"
        }
      }
    },
    {
      "name": "Eliminar Auto",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/autos/1"
        }
      }
    },
    {
      "name": "Error: id no numérico (400)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/autos/abc"
        }
      }
    },
    {
      "name": "Error: auto inexistente (404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/autos/999"
        }
      }
    },
    {
      "name": "Error: competición inexistente (400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"modelo\": \"F1-75\",\n  \"marca\": \"Ferrari\",\n  \"numero\": 16,\n  \"potencia\": 1000,\n  \"piloto\": \"Leclerc\",\n  \"categoria\": \"F1\",\n  \"competicionId\": 999\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/autos"
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ]
}
